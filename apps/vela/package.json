{
  "name": "@vela/app",
  "version": "0.0.1",
  "description": "Vela Japanese Learning App",
  "productName": "Vela",
  "author": "cwchanap <cwchanap@connect.ust.hk>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint \"./src/**/*.{ts,js,vue}\"",
    "lint:fix": "eslint \"./src/**/*.{ts,js,vue}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path ../../.gitignore",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "dev": "quasar dev",
    "dev:extension-test": "bun run dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@quasar/extras": "^1.16.4",
    "@tanstack/vue-query": "^5.104.5",
    "@vela/common": "workspace:*",
    "aws-amplify": "^6.22.2",
    "dompurify": "^3.4.17",
    "marked": "^16.4.1",
    "path-browserify": "^1.0.1",
    "pinia": "^2.1.7",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1154.0",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^2.1.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@quasar/quasar-app-extension-testing": "^2.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.0.10",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "bun": ">= 1.3.1"
  }
}
