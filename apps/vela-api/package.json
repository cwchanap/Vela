{
  "name": "vela-api",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "dev:extension-test": "bun run dev",
    "build": "NODE_ENV=production bun build src/index.ts --outdir dist --target bun --minify --sourcemap",
    "test": "bun run test:unit",
    "test:unit": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@aws/aurora-dsql-node-postgres-connector": "0.1.9",
    "@aws-sdk/client-cognito-identity-provider": "^3.1154.0",
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/credential-providers": "3.1154.0",
    "@aws-sdk/dsql-signer": "3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@hono/zod-validator": "^0.9.1",
    "@vela/common": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.13",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  }
}
