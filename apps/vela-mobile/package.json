{
  "name": "@vela/mobile",
  "version": "0.0.1",
  "description": "Vela Mobile - iOS Japanese Learning App",
  "productName": "Vela",
  "author": "cwchanap <cwchanap@connect.ust.hk>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:ios": "bun run sync:ios-version -- --mode=development && quasar dev -m capacitor -T ios",
    "build": "quasar build",
    "build:ios": "bun run sync:ios-version && quasar build -m capacitor -T ios",
    "build:ios:ide": "bun run sync:ios-version && quasar build -m capacitor -T ios --ide",
    "build:ios:assets": "bun run sync:ios-version && quasar build -m capacitor -T ios --skip-pkg",
    "sync:ios-version": "bun run scripts/sync-ios-version.mjs",
    "scan:secrets": "bun run scripts/scan-mobile-secrets.mjs",
    "verify:m1-foundation": "bun run scripts/verify-m1-foundation.mjs",
    "verify:deployed-config": "bun run build/verify-deployed-config.ts",
    "verify:production-diagnostics": "bun run build:ios:assets && bun run scripts/verify-production-diagnostics.mjs",
    "lint": "eslint \"./src/**/*.{ts,js,vue}\" \"./build/**/*.{ts,js}\" \"./scripts/**/*.{mjs,js,ts}\"",
    "lint:fix": "eslint \"./src/**/*.{ts,js,vue}\" \"./build/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "bun run test:unit",
    "typecheck": "quasar prepare && vue-tsc --noEmit",
    "postinstall": "quasar prepare && bun install --cwd src-capacitor --frozen-lockfile",
    "clean": "rm -rf dist .quasar"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.5",
    "@quasar/extras": "^1.16.4",
    "@vela/common": "workspace:*",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.4.0",
    "@quasar/vite-plugin": "^1.8.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "bun": ">= 1.3.1"
  }
}
